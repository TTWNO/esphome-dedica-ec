# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored so your credentials never get committed.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate with:  openssl rand -base64 32
api_key: "PASTE_A_32_BYTE_BASE64_KEY_HERE"

# Any password you like (used for over-the-air updates)
ota_password: "choose-an-ota-password"
